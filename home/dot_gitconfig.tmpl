[color]
	ui = auto
	diff
	diff-highlight = always

[core]
	pager = delta
	editor = nvim

[delta]
	navigate = true
	light = true
	side-by-side = true

[diff]
	colorMoved = default

[ghq]
	root = ~/.ghq

[init]
	defaultBranch = main

[interactive]
	diffFilter = delta --color-only

[merge]
	conflictStyle = diff3

[pull]
	rebase = true
	autoStash = true

[push]
	useForceIfIncludes = true

[rebase]
	autoStash = true

[rerere]
	enabled = true

